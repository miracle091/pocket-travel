<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Aggiornamento dell'app da dentro l'app (PackageInstaller): senza il primo il sistema rifiuta la sessione;
         il secondo toglie la finestra di conferma di Android 12+ quando le condizioni lo permettono. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Posizione solo per la navigazione (GPS, in primo piano, chiesta al primo "Indicazioni"):
         niente ACCESS_BACKGROUND_LOCATION. COARSE va chiesto insieme a FINE da Android 12. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Il GPS serve solo alla navigazione: senza, l'app si installa e il resto funziona. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Backup spento ovunque: allowBackup="false" fino ad Android 11, dataExtractionRules da 12 in
         su. fullBackupContent non serve (vale solo con il backup attivo), da qui il tools:ignore. -->
    <application
        tools:ignore="DataExtractionRules"
        android:name=".PocketTravelApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:targetApi="33">

        <!-- locale|layoutDirection: il cambio di lingua (da Android 13 via LocaleManager) non ricrea l'activity, Compose
             ridisegna i testi con la nuova configurazione; ricrearla lasciava circa un secondo di schermo nero.
             singleTop: un `geo:` o una condivisione con l'app già in cima al suo task arrivano all'istanza aperta (onNewIntent)
             invece di aggiungerne un'altra, con la sua mappa (circa 46 MB ciascuna sull'emulatore). -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketTravel.Splash"
            android:configChanges="locale|layoutDirection"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Posizione `geo:` da un'altra app (rubrica, browser, app di chat): il Navigatore la legge e mostra l'anteprima del
                 percorso, senza avviare niente. Il testo dell'URI è input non fidato: MainActivity lo accorcia e readPlace
                 ne accetta solo le forme note. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <!-- «Navigatore» nel menu Condividi: testo con coordinate o un link di Google Maps o OpenStreetMap, da un'altra app. Alias di
             MainActivity, perché ACTION_SEND text/plain va già a «Chiedi all'assistente» (ProcessTextActivity), che resta. Stessi
             controlli del filtro geo: sopra. -->
        <activity-alias
            android:name=".SharePlaceAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/share_to_navigator"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- "Chiedi all'assistente": testo selezionato in un'altra app (menu di selezione) o condiviso. Tema trasparente,
             fuori dai recenti: il foglio si chiude e l'app sotto resta com'era. -->
        <activity
            android:name=".assistant.ProcessTextActivity"
            android:label="@string/ai_selected_text_title"
            android:theme="@style/Theme.PocketTravel.Transparent"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Esito della sessione di installazione (AppInstallReceiver): lo riceve solo l'app. -->
        <receiver
            android:name=".updates.AppInstallReceiver"
            android:exported="false" />

        <!-- Dopo un aggiornamento installato dall'app, la notifica che la riapre (AppUpdatedReceiver): lo manda solo il sistema. -->
        <receiver
            android:name=".updates.AppUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Widget della schermata Home (Glance): "Emergenza" e "Scorciatoie". Li chiama solo il sistema (APPWIDGET_UPDATE). -->
        <receiver
            android:name=".widget.EmergencyWidgetReceiver"
            android:label="@string/widget_emergency_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/emergency_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ShortcutsWidgetReceiver"
            android:label="@string/widget_shortcuts_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shortcuts_widget_info" />
        </receiver>

        <!-- Disabilita l'auto-init di default di WorkManager (via androidx.startup): senza
             questo, WorkManager si inizializza da solo prima che PocketTravelApp (Configuration.
             Provider) possa fornire HiltWorkerFactory, e ogni @HiltWorker fallisce con
             NoSuchMethodException (WorkManager prova il costruttore riflessivo di default,
             non trova quello @AssistedInject con le dipendenze Hilt). Vedi
             developer.android.com/topic/libraries/architecture/workmanager/advanced/custom-configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
