<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PocketTravelApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketTravel.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disabilita l'auto-init di default di WorkManager (via androidx.startup): senza
             questo, WorkManager si inizializza da solo prima che PocketTravelApp (Configuration.
             Provider) possa fornire HiltWorkerFactory, e ogni @HiltWorker fallisce con
             NoSuchMethodException (WorkManager prova il costruttore riflessivo di default,
             non trova quello @AssistedInject con le dipendenze Hilt). Vedi
             developer.android.com/topic/libraries/architecture/workmanager/advanced/custom-configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
