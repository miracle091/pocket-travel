<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Posizione solo per la navigazione (GPS, in primo piano, chiesta al primo "Indicazioni"):
         niente ACCESS_BACKGROUND_LOCATION. COARSE va chiesto insieme a FINE da Android 12. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Il GPS serve solo alla navigazione: senza, l'app si installa e il resto funziona. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Backup spento ovunque: allowBackup="false" fino ad Android 11, dataExtractionRules da 12 in
         su. fullBackupContent non serve (vale solo con il backup attivo), da qui il tools:ignore. -->
    <application
        tools:ignore="DataExtractionRules"
        android:name=".PocketTravelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:targetApi="33">

        <!-- locale|layoutDirection: il cambio di lingua (da Android 13 via LocaleManager) non ricrea l'activity, Compose
             ridisegna i testi con la nuova configurazione; ricrearla lasciava circa un secondo di schermo nero. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketTravel.Splash"
            android:configChanges="locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disabilita l'auto-init di default di WorkManager (via androidx.startup): senza
             questo, WorkManager si inizializza da solo prima che PocketTravelApp (Configuration.
             Provider) possa fornire HiltWorkerFactory, e ogni @HiltWorker fallisce con
             NoSuchMethodException (WorkManager prova il costruttore riflessivo di default,
             non trova quello @AssistedInject con le dipendenze Hilt). Vedi
             developer.android.com/topic/libraries/architecture/workmanager/advanced/custom-configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
