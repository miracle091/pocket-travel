<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MapLibre 13 dichiara i permessi di posizione nel suo manifest: l'app non usa la posizione
         (nessun "sono qui" sulla mappa), quindi non devono finire nell'APK. Da togliere (con la
         richiesta a runtime) quando arriva la navigazione. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <!-- Backup spento ovunque: allowBackup="false" fino ad Android 11, dataExtractionRules da 12 in
         su. fullBackupContent non serve (vale solo con il backup attivo), da qui il tools:ignore. -->
    <application
        tools:ignore="DataExtractionRules"
        android:name=".PocketTravelApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketTravel.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disabilita l'auto-init di default di WorkManager (via androidx.startup): senza
             questo, WorkManager si inizializza da solo prima che PocketTravelApp (Configuration.
             Provider) possa fornire HiltWorkerFactory, e ogni @HiltWorker fallisce con
             NoSuchMethodException (WorkManager prova il costruttore riflessivo di default,
             non trova quello @AssistedInject con le dipendenze Hilt). Vedi
             developer.android.com/topic/libraries/architecture/workmanager/advanced/custom-configuration. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
