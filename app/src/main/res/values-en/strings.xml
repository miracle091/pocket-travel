    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Pocket Travel</string>
    <string name="onboarding_welcome_body">A travel guide that works even offline: local customs, border rules, vaccinations, maps and a built-in AI assistant. No account, no personal data collected</string>
    <string name="onboarding_ai_title">The AI assistant has two modes</string>
    <string name="onboarding_ai_body">\"On device\" works even without internet: a small model downloaded to the phone (at least 4 GB of RAM) answers using the guide and your notes. \"Online\" uses a service of your choice (ChatGPT, Mistral, Gemini or Claude) with your own API key, which stays on the phone</string>
    <string name="onboarding_ai_online_title">The AI assistant is available Online</string>
    <string name="onboarding_ai_online_body">Your phone has less than 4 GB of RAM, so \"On device\" mode isn\'t available. The AI assistant works in Online mode, with a service of your choice (ChatGPT, Mistral, Gemini or Claude) and your own API key, which stays on the phone</string>
    <string name="onboarding_vault_title">Your documents stay safe</string>
    <string name="onboarding_vault_body">Passport and vaccination certificates are kept in \"Documents\", protected by biometrics or screen lock and never sent off the device</string>
    <string name="onboarding_sources_title">Official sources open online</string>
    <string name="onboarding_sources_body">Embassies, ministries and WHO open in a browser tab and require a connection: the app never saves them offline, so they stay up to date</string>
    <string name="onboarding_usage_mode_title">How do you travel?</string>
    <string name="onboarding_usage_mode_body">The map will show the points useful to you first. You can change it anytime from More, or skip this step</string>
    <string name="onboarding_nationality_title">What country are you from?</string>
    <string name="onboarding_nationality_body">Each region\'s guide has contacts for your country\'s embassies and consulates, along with emergency numbers. You can change it anytime from More</string>
    <string name="onboarding_nationality_change">Change</string>
    <string name="onboarding_guides_title">Guides for all countries</string>
    <string name="onboarding_guides_body">Optional: local customs, safety and emergency numbers for every country, so you can check them even before choosing a region. If you skip this step, they\'ll download automatically the next time you\'re on Wi-Fi</string>
    <string name="onboarding_guides_download">Download the guides (%1$s)</string>
