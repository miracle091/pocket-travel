    <string name="onboarding_region_title">Scarica una regione per iniziare</string>
    <string name="onboarding_region_body">Facoltativo: mappa, percorsi e punti di interesse sono organizzati in pacchetti regionali. Puoi scaricarne una qui o in qualsiasi momento dalla schermata Regioni.</string>
    <string name="onboarding_model_title">Scarica il modello IA</string>
