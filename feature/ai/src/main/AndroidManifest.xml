<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Input vocale dell'assistente: l'audio va solo al riconoscitore sul dispositivo, non si salva. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- AnswerService.kt: la risposta dell'assistente continua a schermo spento (servizio in primo piano e wake lock) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!-- specialUse: la generazione con un modello sul dispositivo non e' nessuno dei tipi di Android 14 -->
        <service
            android:name=".AnswerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device LLM inference for the travel assistant answer in progress" />
        </service>
        <!-- "Invia a un altro telefono": condivide il GGUF scaricato in sola lettura. -->
        <provider
            android:name="com.pockettravel.feature.ai.ModelFileProvider"
            android:authorities="${applicationId}.modelfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/model_file_paths" />
        </provider>
    </application>
</manifest>
